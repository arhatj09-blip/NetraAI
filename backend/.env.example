# NetraAI Backend Configuration
# Copy this file to .env and update values as needed

# Environment
ENVIRONMENT=development

# Server Configuration
PORT=8000
API_BASE_URL=http://localhost:8000

# CORS Origins (comma-separated)
# Add frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Data Paths (relative to backend directory)
DATA_PATH_X=../data/x
DATA_PATH_REDDIT=../data/reddit
DATA_PATH_TELEGRAM=../data/telegram

# Pipeline Configuration
PIPELINE_REFRESH_INTERVAL=600  # seconds (10 minutes)
BATCH_SIZE=1000

# Future API Keys (not needed for Phase 1)
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
